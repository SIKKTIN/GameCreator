export type StyleField='direction'|'mood'|'view'|'rendering'|'shape'|'lighting'|'texture'|'ui'|'motion'|'avoid';
export type StyleDefinition=Record<StyleField,string>&{palette:{id:string;name:string;color:string;usage:string}[];references:{id:string;title:string;source:string;take:string;avoid:string}[];categories:{id:string;rules:string}[]};
export type StyleVersion={revision:number;at:string;note:string;definition:StyleDefinition};
export type ArtStyle={schema:1;draft:StyleDefinition;versions:StyleVersion[]};
export type StyleException={requirements:string;reason:string};
export type StyleReview={revision:number;categoryId:string;at:string;exception:StyleException};
export type StyledItem={styleException?:StyleException;styleReview?:StyleReview};
export const artStyleFields:Record<StyleField,string>;
export const styleReviewLabels:Record<'unconfirmed'|'pending'|'changed'|'reviewed',string>;
export function emptyStyleDefinition():StyleDefinition;
export function emptyArtStyle():ArtStyle;
export function validateStyleDefinition(value:unknown):StyleDefinition;
export function validateArtStyle(value:unknown):void;
export function validateStyleItem(value:unknown):void;
export function stableStyle(value:unknown):string;
export function currentArtStyle(style?:ArtStyle):StyleVersion|undefined;
export function styleDraftChanged(style?:ArtStyle):boolean;
export function confirmArtStyle(style:ArtStyle,note:string,at?:string):ArtStyle;
export function validateStyleMutation(before:ArtStyle|undefined,after:ArtStyle|undefined):void;
export function styleExceptionOf(item?:StyledItem):StyleException;
export function styleReviewState(style:ArtStyle|undefined,item:StyledItem,categoryId:string):keyof typeof styleReviewLabels;
export function reviewArtStyle(style:ArtStyle|undefined,item:StyledItem,categoryId:string,at?:string):StyleReview;
export function styleDefinitionMarkdown(definition:StyleDefinition,categories?:{id:string;name:string}[],categoryId?:string):string;
